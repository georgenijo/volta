#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
# Commit metadata is public too: only the GitHub noreply identity may author here.
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  if ! git var "$who" | grep -q '@users\.noreply\.github\.com>'; then
    echo "privacy-check: $who must use a users.noreply.github.com email (git config user.email)" >&2
    exit 1
  fi
done
exec "$(git rev-parse --show-toplevel)/scripts/privacy-check.sh"
