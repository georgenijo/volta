# Defaults are inert; no Tesla developer application or credentials exist yet.
COMMANDER_MODE=stub
COMMANDER_COMMANDS_ENABLED=false
COMMANDER_OAUTH_ENABLED=false
COMMANDER_INTERNAL_SECRET=
# openssl rand -base64 32 (32 decoded bytes). Keep stable across restarts.
COMMANDER_ENCRYPTION_KEY=
COMMANDER_VEHICLES={}
COMMANDER_DATA_PATH=/var/lib/volta/commander
COMMANDER_PUBLIC_PATH=/etc/volta/commander-public
COMMANDER_SECRET_PATH=/etc/volta/commander-secrets

# Fill only after George has registered the developer application.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
# Live container paths; set these after generating and mounting actual keys:
TESLA_PROXY_CA_FILE=
TESLA_PUBLIC_KEY_FILE=

# Fleet Telemetry stays staged off until the receiver, meter and signed-config
# live gates pass. Commander mounts the consumer's protected status-secret file.
COMMANDER_TELEMETRY_ENABLED=false
# Required when enabled: the receiver's public name. Tesla rejects names outside
# the partner account's registered domain ("hostname domain does not match with
# partner account"), so a ts.net name only works for a ts.net partner domain.
# The port is the router's external port forwarded to the receiver.
COMMANDER_TELEMETRY_HOSTNAME=telemetry.example.com
COMMANDER_TELEMETRY_PORT=443
TELEMETRY_CERT_DIR=/opt/volta-telemetry/certs
TELEMETRY_STATUS_SECRET_FILE=/opt/volta-telemetry/secrets/status-secret
COMMANDER_TELEMETRY_WARN_USD=20
COMMANDER_TELEMETRY_STOP_USD=23
COMMANDER_TELEMETRY_CAP_USD=25
COMMANDER_TELEMETRY_DELETE_RESERVE_USD=2
COMMANDER_TOTAL_MONTHLY_CAP_USD=30
# Telemetry supplies dense data; polling remains a $5 segmentation/fallback lane.
COMMANDER_MONTHLY_BUDGET_USD=5

# Optional zero-Fleet-API-cost TeslaMate reads (independent of telemetry control).
COMMANDER_TELEMETRY_READS=false
# Private DSN for the narrowly granted volta_commander_reader role; never commit.
COMMANDER_TELEMETRY_DATABASE_URL=
TESLAMATE_NETWORK=teslamate_default
