# Defaults are inert; no Tesla developer application or credentials exist yet.
COMMANDER_MODE=stub
COMMANDER_COMMANDS_ENABLED=false
COMMANDER_OAUTH_ENABLED=false
COMMANDER_INTERNAL_SECRET=
# openssl rand -base64 32 (32 decoded bytes). Keep stable across restarts.
COMMANDER_ENCRYPTION_KEY=
COMMANDER_VEHICLES={}
COMMANDER_DATA_PATH=/var/lib/volta/commander
COMMANDER_PUBLIC_PATH=/etc/volta/commander-public
COMMANDER_SECRET_PATH=/etc/volta/commander-secrets

# Fill only after George has registered the developer application.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
# Live container paths; set these after generating and mounting actual keys:
TESLA_PROXY_CA_FILE=
TESLA_PUBLIC_KEY_FILE=
