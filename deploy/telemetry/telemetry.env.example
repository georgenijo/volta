# Copy to /opt/volta-telemetry/telemetry.env (root:root 0600). No secrets
# here: secrets are files under TELEMETRY_SECRET_DIR, mounted read-only.
TELEMETRY_CERT_DIR=/opt/volta-telemetry/certs
TELEMETRY_SECRET_DIR=/opt/volta-telemetry/secrets
# Monthly streaming reservation inside the shared $30 gross cap. The meter
# reports warn at $20 and stop at $23; commander deletes the vehicle's
# fleet_telemetry_config at stop or when the meter is unknown.
TELEMETRY_RESERVATION_USD=25
TELEMETRY_WARN_RATIO=0.8
TELEMETRY_STOP_RATIO=0.92
# Receiver identity and exposure. Tesla only accepts a telemetry hostname
# under the partner account's registered domain. With the private source,
# cert/renew-cert.sh keeps a local CA (TELEMETRY_CA_DIR, default
# /opt/volta-telemetry/private-ca) and issues a 90-day leaf for this name.
# TELEMETRY_RECEIVER_BIND publishes 8448 on that one LAN address for the
# router port-forward; leave it unset for loopback only.
TELEMETRY_CERT_SOURCE=private
TELEMETRY_HOST=telemetry.example.com
#TELEMETRY_RECEIVER_BIND=192.0.2.10
