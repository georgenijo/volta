# Merge into TeslaMate's env (owning stack: teslamate-host/ubuntu) and attach
# the teslamate service to the external `volta-collector` network. TeslaMate
# then reads through commander's read-only collector; real Tesla tokens never
# reach TeslaMate, Grafana, or its database.
#
# TOKEN is the collector secret, NOT a Tesla token. TeslaMate shows TOKEN on its
# sign-in page, so keep TeslaMate's web UI private (tailnet only), as today.
TOKEN=<COMMANDER_COLLECTOR_SECRET>
TESLA_API_HOST=http://commander:8092
TESLA_AUTH_HOST=http://commander:8092
TESLA_AUTH_PATH=/oauth2/v3
# Streaming is not provided. Point it at commander (rejected locally, nothing
# leaves the host) and turn off "Use streaming API" for each car in TeslaMate.
TESLA_WSS_HOST=ws://commander:8092
